DATABASE_URL=postgresql://wowtasks:wowtasks_dev_2026@localhost:5432/wowtasks
JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development

# Comma-separated list of extra allowed CORS origins (production frontend URL)
FRONTEND_URL=https://your-frontend.web.app

# Firebase Admin SDK (for push notifications) — pick ONE option:
# Option A (recommended for Railway/hosting): paste the whole service account JSON as one line
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
# Option B: separate fields
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# Option C (local dev only): path to the downloaded JSON file
FIREBASE_ADMIN_SDK_PATH=./firebase-adminsdk.json

UPLOAD_DIR=./uploads
